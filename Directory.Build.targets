<Project>
  <Target Name="ValidatePublicSourceRevision" BeforeTargets="PrepareForBuild;PrepareForPublish">
    <Error Condition="'$(PublicReleaseBuild)' != 'true' and '$(PublicReleaseBuild)' != 'false'"
           Text="PublicReleaseBuild must be true or false." />
    <Error Condition="'$(PublicReleaseBuild)' == 'true' and '$(PublicSourceRevision)' == ''"
           Text="Public release builds require PublicSourceRevision: supply the full public GitHub commit SHA explicitly." />
    <Error Condition="'$(PublicSourceRevision)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PublicSourceRevision)', '\A[0-9a-fA-F]{40}\z'))"
           Text="PublicSourceRevision must be a full 40-character hexadecimal GitHub commit SHA." />
    <Error Condition="'$(PublicReleaseBuild)' == 'true' and '$(NoBuild)' == 'true'"
           Text="Public release publication must compile its explicit PublicSourceRevision; do not use --no-build." />
  </Target>

  <!-- Product builds must not emit network telemetry or write user-profile telemetry state. -->
  <Target Name="AvaloniaStats" />
</Project>
