<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ExtSieve.App.Controls"
             x:Class="ExtSieve.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ExtSieve.App/Themes/SemanticColors.axaml" />
                <ResourceInclude Source="avares://ExtSieve.App/Themes/TablerIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="controls|TablerIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Viewbox Stretch="Uniform">
                        <Path Width="24"
                              Height="24"
                              Data="{TemplateBinding Data}"
                              Fill="Transparent"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Viewbox>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SecondaryControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource SecondaryControlPressedBrush}" />
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
        </Style>
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
        </Style>
    </Application.Styles>
</Application>
