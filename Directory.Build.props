<Project>
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <Product>ExtSieve</Product>
    <PublicReleaseBuild Condition="'$(PublicReleaseBuild)' == ''">false</PublicReleaseBuild>
    <PublicReleaseUrl Condition="'$(PublicReleaseUrl)' == ''">https://github.com/melnorme6/ExtSieve/releases</PublicReleaseUrl>
    <SupportUrl>https://ko-fi.com/melnorme</SupportUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PackageLicenseExpression"
                      Value="$(PackageLicenseExpression)" />
    <AssemblyMetadata Include="PublicReleaseUrl"
                      Value="$(PublicReleaseUrl)"
                      Condition="'$(PublicReleaseUrl)' != ''" />
    <AssemblyMetadata Include="PublicSourceRevision"
                      Value="$(PublicSourceRevision)"
                      Condition="'$(PublicSourceRevision)' != ''" />
    <AssemblyMetadata Include="SupportUrl"
                      Value="$(SupportUrl)" />
  </ItemGroup>
</Project>
